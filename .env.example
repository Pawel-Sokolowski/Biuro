# Skopiuj ten plik jako ".env" do %LOCALAPPDATA%\Biuro\ (aplikacja zainstalowana)
# albo do katalogu projektu (uruchamianie z PyCharm). Plik .env nie trafia do instalatora.

# Wspólny klucz szyfrowania biura. Aplikacja nie generuje osobnych kluczy dla PC.
# Ustaw ten sam klucz na wszystkich komputerach i workerze; import/eksport w ustawieniach.
BIO_ENCRYPTION_KEY=

# Adres bazy PostgreSQL (wymagane), np. postgresql://uzytkownik:haslo@192.168.1.15:5432/biuro
DB_URL=

CEIDG_BASE_URL=
CEIDG_API_KEY=
GUS_API_URL=
GUS_API_KEY=

# Opcjonalnie: fallback dla problematycznych sterowników graficznych (1 = software).
BIO_SOFTWARE_RENDERING=0
